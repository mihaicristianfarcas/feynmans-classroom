# Commit messages: a subject line of at most 72 characters, then a blank line before any body.
subject=$(head -n 1 "$1")
case "$subject" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac
if [ -z "$subject" ]; then
  echo "✗ Empty commit subject."
  exit 1
fi
if [ ${#subject} -gt 72 ]; then
  echo "✗ The subject line is ${#subject} characters; keep it to 72 (details go in the body)."
  exit 1
fi
second=$(sed -n 2p "$1")
if [ -n "$second" ] && ! printf '%s' "$second" | grep -q '^#'; then
  echo "✗ Leave a blank line between the subject and the body."
  exit 1
fi
