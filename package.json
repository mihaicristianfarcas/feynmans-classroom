{
  "name": "feynmans-classroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first learning platform: read hard books beside interactive figures, spaced repetition, quizzes, the Feynman technique and a Markdown second brain, on your own Codex or Claude Code subscription.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "sync:kit": "node scripts/sync-kit.mjs",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:e2e": "tsx tests/e2e.ts",
    "typecheck": "tsc --noEmit -p .",
    "postinstall": "node scripts/sync-kit.mjs",
    "test:flow": "tsx tests/reader-flow.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anaralabs/lector": "^3.15.5",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@firecrawl/pdf-inspector": "^1.25.2",
    "@hono/node-server": "^2.1.4",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "approx-string-match": "2.0.0",
    "d3-force": "^3.0.0",
    "esbuild": "^0.28.2",
    "hono": "^4.13.13",
    "jszip": "^3.10.2",
    "katex": "^0.19.0",
    "linkedom": "^0.18.13",
    "pdfjs-dist": "^5.7.284",
    "puppeteer-core": "^25.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
